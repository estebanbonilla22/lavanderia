# =================================================================
# Variables de entorno para Docker Compose (local)
# Copia este archivo como .env y ajusta los valores.
# =================================================================

# ----- JWT compartido entre los 3 microservicios (¡cámbialo en producción!) -----
JWT_SECRET=cambia-este-secreto-super-seguro-para-jwt-1234567890
JWT_EXPIRATION_MS=86400000

# ----- MySQL (auth-service) -----
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=lavanderia_auth

# ----- PostgreSQL (laundry-service y order-service) -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ----- CORS: dominios autorizados (separados por coma o * para todos) -----
CORS_ALLOWED_ORIGINS=*

# ----- Usuarios seed creados al iniciar auth-service -----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_USER_USERNAME=user
SEED_USER_PASSWORD=user123

# ----- URLs públicas que el frontend debe consumir (local) -----
AUTH_API_URL=http://localhost:8081
LAUNDRY_API_URL=http://localhost:8082
ORDER_API_URL=http://localhost:8083
